{
  "name": "add-regulations-mcp",
  "main": "src/r2-worker.ts",
  "build": {"command":"node scripts/stamp-build.mjs"},
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "keep_vars": true,
  "observability": {"enabled":true},
  "r2_buckets": [{"binding":"REGULATIONS_ARCHIVE","bucket_name":"add-regulations-archive"}],
  "durable_objects": {"bindings":[{"name":"CORPUS_INDEX_COORDINATOR","class_name":"CorpusIndexCoordinator"}]},
  "migrations": [{"tag":"corpus-index-coordinator-v1","new_sqlite_classes":["CorpusIndexCoordinator"]}],
  "triggers": {"crons":[]}
}
