{
  "name": "add-regulations-mcp",
  "main": "src/index.ts",
  "build": {
    "command": "node scripts/stamp-build.mjs"
  },
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "keep_vars": true,
  "secrets": {
    "required": [
      "ACCESS_CLIENT_SECRET",
      "COOKIE_ENCRYPTION_KEY"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "d62377aa75e141c89930e4a47ad54502"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
