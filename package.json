{
  "name": "add-regulations-mcp",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "prepare": "node scripts/stamp-build.mjs",
    "predeploy": "node scripts/stamp-build.mjs",
    "deploy": "node scripts/deploy-all.mjs",
    "dev": "wrangler dev",
    "prebuild:check": "node scripts/stamp-build.mjs",
    "build:check": "wrangler deploy --dry-run --outdir .build-check",
    "test:regulation-fixes": "node --use-env-proxy --import ./scripts/test-loader.mjs scripts/regulation-defects-regression.ts",
    "test:tables": "node --use-env-proxy --import ./scripts/test-loader.mjs scripts/structured-table-regression.ts",
    "test:delegation-response": "node --use-env-proxy --import ./scripts/test-loader.mjs scripts/delegation-response-regression.ts",
    "sync:d1": "node --use-env-proxy --import ./scripts/test-loader.mjs scripts/d1/sync.ts",
    "test:d1": "node --use-env-proxy --import ./scripts/test-loader.mjs scripts/d1/regression.ts",
    "build:d1": "node scripts/stamp-build.mjs && wrangler deploy --dry-run --config wrangler.d1.jsonc --outdir .build-d1",
    "typecheck:d1": "tsc -p tsconfig.d1.json",
    "sync:r2": "node scripts/stamp-build.mjs && node --use-env-proxy --import ./scripts/test-loader.mjs scripts/r2/sync.ts",
    "test:r2": "node --use-env-proxy --import ./scripts/test-loader.mjs scripts/r2/regression.ts",
    "typecheck:r2": "tsc -p tsconfig.r2.json",
    "build:r2": "node scripts/stamp-build.mjs && wrangler deploy --dry-run --config wrangler.r2.jsonc --outdir .build-r2",
    "test:r2-lifecycle": "node --import ./scripts/test-loader.mjs scripts/r2/lifecycle.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@ssabrojs/hwpxjs": "0.4.0",
    "agents": "0.25.0",
    "cfb": "1.2.2",
    "fflate": "^0.8.2",
    "unpdf": "1.8.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261008.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "wrangler": "^4.0.0"
  }
}
